+bool RequestKeyboardLayoutForWindow(HWND input_window, HKL layout) {
+  const DWORD thread_id = GetWindowThreadProcessId(input_window, nullptr);
+  if (thread_id == 0 || GetKeyboardLayout(thread_id) == layout) return false;
+
+  // WM_INPUTLANGCHANGEREQUEST is normally posted by Windows. Send it with a
+  // bounded wait here so the target window has applied (or rejected) the new
+  // input locale before we touch the locale-specific IME context below.
+  DWORD_PTR ignored_result = 0;
+  const LRESULT delivered = SendMessageTimeoutW(
+      input_window,
+      WM_INPUTLANGCHANGEREQUEST,
+      0,
+      reinterpret_cast<LPARAM>(layout),
+      SMTO_ABORTIFHUNG | SMTO_BLOCK,
+      1000,
+      &ignored_result);
+  return delivered != 0 && GetKeyboardLayout(thread_id) == layout;
+}
