39f63ab0fb36275309a2dfe9fdd7c1bc7e2680 100644
--- a/components/inputMethodMemoryWiring.test.ts
+++ b/components/inputMethodMemoryWiring.test.ts
@@ -10,7 +10,8 @@ test("terminal settings use the normal settings object without fragile one-off p
   const settingsPage = read("./SettingsPage.tsx");
   const terminalTab = read("./settings/tabs/SettingsTerminalTab.tsx");
 
-  assert.match(settingsPage, /<LazySettingsTerminalTab \{\.\.\.props\} availableFonts=\{availableFonts\} \/>/);
+  assert.match(settingsPage, /\| 'terminalSettings'/);
+  assert.match(settingsPage, /\| 'updateTerminalSetting'/);
   assert.doesNotMatch(settingsPage, /inputMethodMemoryEnabled=\{settings\.inputMethodMemoryEnabled\}/);
   assert.doesNotMatch(settingsPage, /setInputMethodMemoryEnabled=\{settings\.setInputMethodMemoryEnabled\}/);
   assert.match(terminalTab, /checked=\{terminalSettings\.inputMethodMemoryEnabled\}/);
@@ -43,3 +44,20 @@ test("Electron registers and exposes the native input method bridge", () => {
   assert.match(preload, /resetInputMethodSurfaceMemory: \(\) => ipcRenderer\.invoke\("netcatty:input-method:reset"\)/);
   assert.match(types, /setInputMethodSurface\?\(surface: 'terminal' \| 'ai-chat' \| null\)/);
 });
+
+
+test("the Windows adapter applies the input locale before IME mode state", () => {
+  const nativeSource = read("../packages/input-method-native/src/input_method.cc");
+
+  assert.match(nativeSource, /SendMessageTimeoutW\(/);
+  assert.match(nativeSource, /GetKeyboardLayout\(thread_id\) == layout/);
+  assert.doesNotMatch(nativeSource, /PostMessageW\(/);
+  const requestBody = nativeSource.slice(
+    nativeSource.indexOf("Napi::Value RequestInputMethodStateForWindow"),
+    nativeSource.indexOf("#else"),
+  );
+  assert.ok(
+    requestBody.indexOf("RequestKeyboardLayoutForWindow(input_window, layout)")
+      < requestBody.indexOf("const ImeContextHandle context = AcquireImeContext"),
+  );
+});
